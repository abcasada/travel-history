#!/usr/bin/env bash
# Development wrapper: every tool runs in a container (nothing is installed on the host).
set -euo pipefail
cd "$(dirname "$0")"
# shellcheck source=scripts/stack.sh
source scripts/stack.sh

# The development project only; the production stack is `./dev prod …` (scripts/prod.sh).
compose() { dev_compose "$@"; }
node_run() {
  docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp -e npm_config_update_notifier=false \
    -v "$PWD/frontend:/src" -w /src node:24.22.0-trixie-slim@sha256:a6155384446670e9719bdc4fd0ebe4d4b29fb32a8d6aa523da3547a6cfbcf22c "$@"
}
env_value() { env_file_value .env "$1"; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  setup)
    git config core.hooksPath .githooks
    if [ ! -f .env ]; then
      in_worktree && die "a worktree gets its .env from ./dev lane new <item> (main checkout)"
      env_from_example .env.example .env
      echo "created .env with generated secrets (edit TRAVEL_LAN_BIND / TRAVEL_DEV_HOST for LAN access)"
    fi
    bulk="$(env_value TRAVEL_BULK_DIR)"
    mkdir -p "$bulk"/{raw,media,backup-outbox,uploads}
    docker network inspect valhalla >/dev/null 2>&1 || docker network create valhalla >/dev/null
    [ -d frontend/node_modules ] || node_run npm ci --no-audit --no-fund
    echo "setup done"
    ;;
  up)       compose up -d --build "$@" ;;
  down)     compose down "$@" ;;
  ps)       compose ps "$@" ;;
  logs)     compose logs -f --tail=100 "$@" ;;
  build)    compose build "$@" ;;
  manage)   compose run --rm tools python manage.py "$@" ;;
  shell)    compose run --rm tools python manage.py shell "$@" ;;
  psql)     compose exec db psql -U travel_owner -d travel "$@" ;;
  test)
    "$0" test-backend
    "$0" test-frontend
    ;;
  test-backend)
    compose up -d db
    compose run --rm tools pytest "$@"
    ;;
  test-quick)
    # Everything except tests marked slow; the full suite (./dev test) still runs them.
    "$0" test-backend -m "not slow" "$@"
    "$0" test-frontend
    ;;
  test-frontend)
    node_run bash -c 'npx tsc -b --noEmit && npx vitest run'
    ;;
  lint)
    compose run --rm --no-deps tools ruff check .
    compose run --rm --no-deps tools ruff format --check .
    node_run npx biome check src
    ;;
  fmt)
    compose run --rm --no-deps tools ruff format .
    compose run --rm --no-deps tools ruff check --fix .
    node_run npx biome check --write src
    ;;
  backup-now)
    compose run --rm backup /backup/backup.sh
    ;;
  restore-test)
    # Backup -> restore -> verify, end to end, with a throwaway key (never the real one).
    refuse_in_worktree "./dev restore-test"
    scripts/restore-test.sh dev
    ;;
  prod)
    # The production stack: its own compose project, database and .env.prod (D-96).
    refuse_in_worktree "./dev prod"
    exec scripts/prod.sh "$@"
    ;;
  tracker)
    # The internet-facing tracker endpoint moved to the production stack (D-96).
    refuse_in_worktree "./dev tracker"
    exec scripts/prod.sh tracker "$@"
    ;;
  valhalla)
    # Valhalla is its own compose project (valhalla/compose.yaml, docs/valhalla.md); the app
    # reaches it as http://valhalla:8002 over the shared `valhalla` network.
    vc() { docker compose -f valhalla/compose.yaml "$@"; }
    sub="${1:-help}"; shift || true
    # The service is shared by every stack: only the main checkout builds, starts or stops it.
    case "$sub" in build|up|down) refuse_in_worktree "./dev valhalla $sub" ;; esac
    case "$sub" in
      build)
        docker network inspect valhalla >/dev/null 2>&1 || docker network create valhalla >/dev/null
        mkdir -p valhalla/data
        VALHALLA_UID="$(id -u)" VALHALLA_GID="$(id -g)" vc run --rm build
        # Load the new tiles if the service is already running.
        if [ -n "$(vc ps -q valhalla 2>/dev/null)" ]; then vc restart valhalla; fi
        ;;
      up)
        [ -e valhalla/data/current/valhalla.json ] || { echo "no tiles yet: run ./dev valhalla build first" >&2; exit 1; }
        VALHALLA_UID="$(id -u)" VALHALLA_GID="$(id -g)" vc up -d valhalla
        printf 'waiting for valhalla to be healthy'
        for _ in $(seq 1 30); do
          state="$(docker inspect -f '{{.State.Health.Status}}' "$(vc ps -q valhalla)" 2>/dev/null || true)"
          [ "$state" = healthy ] && break
          printf '.'; sleep 2
        done
        echo " ${state:-not running}"
        [ "$state" = healthy ] || { vc logs --tail=30 valhalla; exit 1; }
        ;;
      down)   vc down ;;
      logs)   vc logs -f --tail=100 valhalla ;;
      status)
        vc ps valhalla
        cat valhalla/data/current/BUILD_INFO.json 2>/dev/null || echo "no build yet"
        vc exec valhalla curl -fsS http://127.0.0.1:8002/status && echo
        ;;
      smoke)  compose run --rm --no-deps tools python manage.py valhalla_smoke "$@" ;;
      *)      echo "./dev valhalla build | up | down | status | logs | smoke" ;;
    esac
    ;;
  npm)      node_run npm "$@" ;;
  e2e)
    # Headless Chrome (host network: containers can't reach the host's LAN address otherwise).
    vite="$(env_value TRAVEL_VITE_PORT)"
    base="${1:-http://$(env_value TRAVEL_DEV_HOST):${vite:-5173}}"
    # Per-stack browser container and debugging port, so lanes can run e2e beside each other.
    chrome="travel-e2e-chrome${LANE_ITEM:+-$LANE_ITEM}"
    cdp="$(env_value TRAVEL_CDP_PORT)"; cdp="${cdp:-9222}"
    oidc_port="$(env_value TRAVEL_OIDC_PORT)"; oidc_port="${oidc_port:-8781}"
    mkdir -p e2e/out
    [ -d e2e/node_modules ] || docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp \
      -v "$PWD/e2e:/w" -w /w node:24.22.0-trixie-slim@sha256:a6155384446670e9719bdc4fd0ebe4d4b29fb32a8d6aa523da3547a6cfbcf22c npm ci --no-audit --no-fund
    docker rm -f "$chrome" >/dev/null 2>&1 || true  # a previous run's container may still be going away
    docker run -d --rm --name "$chrome" --network host --shm-size=1g zenika/alpine-chrome:124 \
      --no-sandbox --remote-debugging-address=127.0.0.1 --remote-debugging-port="$cdp" \
      --use-gl=swiftshader --enable-unsafe-swiftshader about:blank >/dev/null
    trap 'docker rm -f "$chrome" >/dev/null' EXIT  # rm -f returns only once the name is free
    sleep 3
    docker run --rm --network host --user "$(id -u):$(id -g)" -e HOME=/tmp \
      -e CDP_PORT="$cdp" -e OIDC_PORT="$oidc_port" \
      -v "$PWD/e2e:/w" -w /w node:24.22.0-trixie-slim@sha256:a6155384446670e9719bdc4fd0ebe4d4b29fb32a8d6aa523da3547a6cfbcf22c node smoke.mjs "$base" && status=0 || status=$?
    # Each run re-uploads the same synthetic fixture; drop the duplicate batches it leaves.
    "$0" manage e2e_cleanup "$(sha256sum e2e/fixtures/timeline-synthetic.json | cut -d' ' -f1)"
    exit "$status"
    ;;
  import-scale-test) scripts/import-scale-test.sh "$@" ;;
  golive-smoke)
    # The go-live smoke test (item 40d, docs/go-live.md): `local` builds HEAD's production image
    # and runs it with scope `all` against a throwaway DB on 127.0.0.1 (lanes too); a https URL
    # checks the public names through Cloudflare.
    exec scripts/golive-smoke.sh "$@"
    ;;
  load-reference)
    # The public reference data (GeoNames gazetteer, airports, airlines) from the cached copies
    # in var/bulk/reference; a lane gets those copied by ./dev lane new (GeoNames pins can't be
    # downloaded again, D-94). Upserts only; never deletes.
    "$0" manage load_flight_reference
    "$0" manage load_gazetteer
    ;;
  lane)
    exec scripts/lane.sh "$@"
    ;;
  help|*)
    cat <<'HELP'
./dev setup               first-time setup: git hooks, .env with generated secrets, bulk dirs, networks
./dev up | down | ps | logs [svc]   dev stack (db, migrate, web, worker, oidc, mail, frontend)
./dev test                backend + frontend tests
./dev test-backend [args] pytest in the tools container (owner role creates the test DB)
./dev test-frontend       type-check + Vitest
./dev test-quick [args]   like ./dev test, minus tests marked slow (for item ends; full suite at milestones)
./dev lint | fmt          ruff + Biome
./dev manage <cmd>        Django management command (runs as the OWNER role)
./dev shell | psql        Django shell / psql (owner role)
./dev npm <args>          npm inside the Node container (frontend/)
./dev backup-now          run one encrypted backup into the outbox (needs AGE_RECIPIENT in .env)
./dev restore-test        backup -> restore into a scratch DB -> verify (throwaway key)
./dev import-scale-test [size_mb|cleanup]  realistic-size Timeline import on the dev stack (default 1024 MB; deletes its data after)
./dev e2e [base-url]      browser smoke test (sign-in, notice, map, both shells; screenshots in e2e/out/)
./dev golive-smoke local [--keep]   production image of HEAD, scope all, throwaway DB, 127.0.0.1
                          only; every go-live check, then removed (local-check, local-down)
./dev golive-smoke https://<host> [--scope all|tracker]   the same checks through Cloudflare
./dev load-reference      load the gazetteer and flight reference data from var/bulk/reference
./dev lane new <item>     parallel lane: worktree ../travel-history-lanes/<item>, branch item/<item>,
                          own .env, compose project, ports, DB volume and var/bulk (D-98)
./dev lane rm <item> [--force]   remove a lane's stack, volumes and worktree (refuses unmerged)
./dev lane list           lanes with their port blocks
./dev prod <command>      the production stack (127.0.0.1:8784; ./dev prod help): init, deploy,
                          status, ps, logs, migrate, manage, shell, psql, backup-now,
                          restore-test, smoke, down, tracker start|stop|logs|ps|smoke
./dev tracker <command>   same as ./dev prod tracker (the tracker endpoint runs in production)
./dev valhalla build      download the extract (default Kansas) and build routing tiles (docs/valhalla.md)
./dev valhalla up|down|status|logs   run / stop / inspect the Valhalla service (valhalla:8002, no ports)
./dev valhalla smoke      route + map-match through http://valhalla:8002 from the app's network
HELP
    ;;
esac
