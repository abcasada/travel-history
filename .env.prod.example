# Production settings (work-order item 40a, D-96, docs/production.md). `./dev prod init` copies
# this to <prod dir>/.env.prod (beside the repository, mode 0600) with every "generate" value
# replaced by a fresh random secret and __PROD_DIR__ by that directory. The real file is never
# committed. compose.prod.yaml forces DEBUG off, HTTPS-only settings, HSTS and the
# CF-Connecting-IP client address itself; settings.py refuses to start without them.

# Host user that owns the bind-mounted bulk storage (filled in by init).
APP_UID=1000
APP_GID=1000

# Bulk storage: raw imports, photos, backup outbox, dataset cache. Outside the git working tree,
# so `git clean` can't reach it; on the SSD until the replacement HDD is mounted (D-84).
TRAVEL_BULK_DIR=__PROD_DIR__/bulk

# PostgreSQL roles (permissions.md §6.1): fresh passwords, never the development ones.
POSTGRES_SUPERUSER_PASSWORD=generate
TRAVEL_OWNER_PASSWORD=generate
TRAVEL_APP_PASSWORD=generate
TRAVEL_PUBLIC_PASSWORD=generate

# Django. The public host names below are added to the allowed hosts and trusted origins.
DJANGO_SECRET_KEY=generate
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
TRAVEL_PUBLIC_BASE_URL=https://travel.adamcasada.com

# Internet exposure (docs/tracking/exposure.md, D-85, D-96). The first host is canonical; the
# others answer a permanent redirect to the same path on it (tracker paths excepted). The scope
# stays "tracker" (only the tracker endpoints on these names) until go-live (item 40e) sets it
# to "all", after Authentik with 2FA.
TRAVEL_PUBLIC_HOSTS=travel.adamcasada.com,trips.adamcasada.com
TRAVEL_CANONICAL_HOST=travel.adamcasada.com
TRAVEL_PUBLIC_SCOPE=tracker

# Tracker ingestion: the public origin phones send points to (setup links and QR codes).
TRACKER_BASE_URL=https://travel.adamcasada.com
TRACKER_RATE_PER_TOKEN=120
TRACKER_RATE_PER_IP=600

# OIDC: Authentik (item 40c; docs/design/auth.md §7.2). The provider's issuer, e.g.
# https://auth.example.org/application/o/<app slug>/ (the final slash is optional), and the
# confidential client's ID and secret (Adam pastes the secret). The `travel-users` group check
# and the second-factor rule (G-5, D-100) are fixed in settings.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_EXTRA_AUDIENCES=

# Outbound email: not set up yet (Resend, Q-10; later).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=noreply@adamcasada.com

# Backups (docs/design/backup.md §22). Adam pastes the age PUBLIC key ("age1..."); until then
# the nightly job and ./dev prod backup-now refuse to write anything.
AGE_RECIPIENT=
BACKUP_TIME=03:30
KEEP_DUMPS=7
TZ=America/Chicago

# Routing (docs/valhalla.md): the shared Valhalla service; init copies ORS_API_KEY from the
# development .env when it is set there.
VALHALLA_URL=http://valhalla:8002
VALHALLA_COVERAGE=kansas
VALHALLA_DATA_DATE=
ORS_API_KEY=
ROUTING_FOSSGIS_ENABLED=true
