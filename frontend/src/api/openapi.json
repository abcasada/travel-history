          "last_day": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Day"
          }
        },
        "required": [
          "first_day",
          "last_day",
          "days"
        ],
        "title": "CoverageOut",
        "type": "object"
      },
      "DeviceClass": {
        "enum": [
          "any",
          "desktop",
          "mobile"
        ],
        "title": "DeviceClass",
        "type": "string"
      },
      "ImportBatchOut": {
