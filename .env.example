# Copy to .env (./dev setup does this and fills every "generate" value with a random secret).
# .env is git-ignored and must stay mode 0600.

# Host user that owns bind-mounted files (bulk storage).
APP_UID=1000
APP_GID=1000

# Bulk storage (HDD): raw imports, photos, backup outbox. Real instance:
#   TRAVEL_BULK_DIR=/storage/hdd1/travel-history
TRAVEL_BULK_DIR=./var/bulk

# Dev access over LAN/WireGuard: the server's LAN address (never 0.0.0.0, never a public IP).
TRAVEL_LAN_BIND=127.0.0.1
# Host name or IP browsers use to reach the dev stack (also the mock OIDC issuer host).
TRAVEL_DEV_HOST=localhost

# PostgreSQL roles (PLAN.md §6.1)
POSTGRES_SUPERUSER_PASSWORD=generate
TRAVEL_OWNER_PASSWORD=generate
TRAVEL_APP_PASSWORD=generate
TRAVEL_PUBLIC_PASSWORD=generate

# Django
DJANGO_SECRET_KEY=generate
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8780,http://localhost:5173
TRAVEL_PUBLIC_BASE_URL=http://localhost:8780

# OIDC. Dev: the mock provider at http://<TRAVEL_DEV_HOST>:8781/default (any client id/secret).
# Production: Authentik, e.g. https://auth.adamcasada.com/application/o/travel-history/
OIDC_ISSUER=http://localhost:8781/default
OIDC_CLIENT_ID=travel-history-dev
OIDC_CLIENT_SECRET=generate
# Extra accepted audiences for bearer tokens (e.g. the Android companion's client id).
OIDC_EXTRA_AUDIENCES=

# Outbound email (generic SMTP; shared with Authentik). Dev uses Mailpit automatically.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=noreply@adamcasada.com

# Backups (PLAN.md §22). Create the key pair OFF this server (e.g. on your laptop):
#   age-keygen -o travel-backup.key     (keep the file offline + in your password manager)
# and paste only the public key ("age1...") here. Without it, no backup is written.
AGE_RECIPIENT=
BACKUP_TIME=03:30
KEEP_DUMPS=7
TZ=America/Chicago
