# Copy to .env (./dev setup does this and fills every "generate" value with a random secret).
# .env is git-ignored and must stay mode 0600.

# Host user that owns bind-mounted files (bulk storage).
APP_UID=1000
APP_GID=1000

# Bulk storage (HDD): raw imports, photos, backup outbox. Real instance:
#   TRAVEL_BULK_DIR=/storage/hdd1/travel-history
TRAVEL_BULK_DIR=./var/bulk

# Dev stack host ports, backend image tag and DB shared_buffers. A worktree lane (./dev lane new,
# D-98) gets its own block (web 8800+, Vite 5180+) and tag; the main checkout keeps these.
TRAVEL_WEB_PORT=8780
TRAVEL_OIDC_PORT=8781
TRAVEL_MAIL_PORT=8782
TRAVEL_VITE_PORT=5173
TRAVEL_CDP_PORT=9222
TRAVEL_DEV_IMAGE_TAG=latest
TRAVEL_DB_SHARED_BUFFERS=512MB

# Dev access over LAN/WireGuard: the server's LAN address (never 0.0.0.0, never a public IP).
TRAVEL_LAN_BIND=127.0.0.1
# Host name or IP browsers use to reach the dev stack (also the mock OIDC issuer host).
TRAVEL_DEV_HOST=localhost

# PostgreSQL roles (PLAN.md §6.1)
POSTGRES_SUPERUSER_PASSWORD=generate
TRAVEL_OWNER_PASSWORD=generate
TRAVEL_APP_PASSWORD=generate
TRAVEL_PUBLIC_PASSWORD=generate

# Django
DJANGO_SECRET_KEY=generate
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8780,http://localhost:5173
TRAVEL_PUBLIC_BASE_URL=http://localhost:8780
# Header with the real client IP for per-IP rate limits, only when EVERY request arrives through
# that proxy. Empty = the socket address (LAN/VPN dev access). The production stack forces
# CF-Connecting-IP itself (compose.prod.yaml).
RATELIMIT_CLIENT_IP_HEADER=

# Internet exposure (docs/tracking/exposure.md, docs/production.md). Keep this EMPTY in
# development: the dev stack never answers a public host name (a DEBUG server answers 404 to
# any host it doesn't know). The production stack sets its own names in .env.prod (D-96).
TRAVEL_PUBLIC_HOSTS=
# tracker = only the two tracker endpoints on the public host (until go-live); all = the whole
# app (go-live, after Authentik with 2FA: phase 8 checklist).
TRAVEL_PUBLIC_SCOPE=tracker

# Tracker ingestion (docs/tracking/). The public origin phones send points to, used in setup
# links and QR codes (production: https://travel.adamcasada.com, in .env.prod); empty = the
# address the browser used when the token was created (fine for LAN/VPN testing). Rate limits
# are requests per minute per device token and per address.
TRACKER_BASE_URL=
TRACKER_RATE_PER_TOKEN=120
TRACKER_RATE_PER_IP=600

# OIDC. Dev: the mock provider at http://<TRAVEL_DEV_HOST>:8781/default (any client id/secret).
# Production: Authentik, e.g. https://auth.adamcasada.com/application/o/travel-history/
OIDC_ISSUER=http://localhost:8781/default
OIDC_CLIENT_ID=travel-history-dev
OIDC_CLIENT_SECRET=generate
# Extra accepted audiences for bearer tokens (e.g. the Android companion's client id).
OIDC_EXTRA_AUDIENCES=

# Outbound email (generic SMTP; shared with Authentik). Dev uses Mailpit automatically.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=noreply@adamcasada.com

# Backups (PLAN.md §22). Create the key pair OFF this server (e.g. on your laptop):
#   age-keygen -o travel-backup.key     (keep the file offline + in your password manager)
# and paste only the public key ("age1...") here. Without it, no backup is written.
AGE_RECIPIENT=
BACKUP_TIME=03:30
KEEP_DUMPS=7
TZ=America/Chicago

# Routing (docs/valhalla.md). VALHALLA_COVERAGE names backend/travel/routing/coverage/<name>.geojson
# (or a path to a .geojson); switch to north-america only after that build exists.
VALHALLA_URL=http://valhalla:8002
VALHALLA_COVERAGE=kansas
# Optional: OSM extract date of the current Valhalla build (else the tile build time is recorded).
VALHALLA_DATA_DATE=
# OpenRouteService key for routes outside Valhalla's coverage (empty = skip ORS; only user-drawn
# waypoints are ever sent, routing.md §13.1). FOSSGIS OSRM is the emergency fallback (1 req/s).
ORS_API_KEY=
ROUTING_FOSSGIS_ENABLED=true
